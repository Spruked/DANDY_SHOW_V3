*.aup3
*.wav
*.mp3
!introclip.mp3
!introclipdandy222.mp3

# Keep folders
!logs/.gitkeep
!staging/.gitkeep
!archive/.gitkeep
archive/claude_drop/
archive/clean_slate/
archive/frontend_legacy_*/
archive/testing/results/**
!archive/testing/README.md
!archive/testing/results/RESULTS_INDEX.md
frontend_old_*/
frontend/vite-wired*.log

# Episodes output (do not commit long-form audio/assets)
episodes/**/audio*.mp3
episodes/**/production_result.json
episodes/**/status.json
episodes/**/script_versions/
episodes/**/ads/
episodes/**/assets/

# Local model weights
*.pt
*.safetensors
*.bin
*.gguf

# Rendered social output (generated, not source)
social/renders/
social/generated/

# Vendored local sidecar runtime output
secondary_systems/**/.agents/
secondary_systems/**/.codex/
secondary_systems/**/generated_audio/
secondary_systems/**/logs/
secondary_systems/**/staging/
