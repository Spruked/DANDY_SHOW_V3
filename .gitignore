# Audio binaries — track jingle metadata in config, not the files
audio/jingles/*.mp3
audio/sfx/*.mp3
audio/ads/*.mp3
!audio/jingles/.gitkeep
!audio/sfx/.gitkeep
!audio/ads/.gitkeep

# Backup and restore archives (binary, regeneratable)
archive/backups/
archive/restore_points/
!archive/backups/.gitkeep
!archive/restore_points/.gitkeep

# Pillow/FFmpeg render scratch
renders/

# OS/editor
.DS_Store
Thumbs.db
