      "rhythm": {
        "human_load": 0.45,
        "desync_risk": 0.448,
        "turn_latency_ms": 0.0,
        "tempo": "normal",
        "intensity": "medium",
        "verbosity": "medium",
        "cooldown_until_ms": 1791293139759,
