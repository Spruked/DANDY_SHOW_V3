        "desync_risk": 0.448,
        "turn_latency_ms": 0.0,
        "tempo": "normal",
        "intensity": "medium",
        "verbosity": "medium",
        "cooldown_until_ms": 1791293139759,
        "version": 1,
        "interaction_tempo": "normal",
        "cognitive_intensity": "medium",
        "last_turn_ms": 0.0
      },
      "line_number": 17,
      "generated_by": "llamacpp",
      "segment_index": 1,
      "segment_title": "Part 1",
      "canonical_line_id": "canonical_v0001_line_0017_0efa1260"
    },
    {
      "speaker": "phil",
      "text": "That was frustrating for sure. How did they manage before diagnostic tools? Did they have to manually troubleshoot or use different methods?",
      "emotion": "warm",
      "pause_after": 0.35,
      "rhythm": {
        "human_load": 0.45,
